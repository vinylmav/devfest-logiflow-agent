# ==========================================
# LogiFlow Configuration (.env)
# ==========================================

# Model Provider: 'google' (default, Gemini 3.8 Flash via Google ADK) or 'openai' (GPT-4o-mini)
LLM_PROVIDER=google

# Google Gemini Configuration (Native Google ADK Engine)
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# OpenAI Configuration (Alternative Provider & Vision Support)
OPENAI_API_KEY=your_openai_api_key_here

# TypeSafe Jev Configuration (System 1 Fast Decision Layer)
# Optional: LogiFlow automatically falls back to local fast heuristics when key is not set
TYPESAFE_API_KEY=your_typesafe_api_key_here
